// use prisma-8

model Movie {
  id                Int      @id @default(autoincrement())
  title             String
  description       String
  genre             String
  releaseYear       Int
  director          String
  mainActor         String
  rating            Float
streamingPlatform String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @onCreate(now()) @onUpdate(now())
  isDeleted         Boolean  @default(false)
  
}